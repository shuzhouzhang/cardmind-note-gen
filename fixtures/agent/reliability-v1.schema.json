{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardmind.local/schemas/agent-reliability-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "mode", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "reliability-v1" },
    "mode": { "const": "replay" },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "input", "replayTurns", "sandbox", "approvalDecisions", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "required": ["userInput"],
          "properties": {
            "userInput": { "type": "string" },
            "activeChatId": { "type": "number" },
            "activeFilePath": { "type": "string" },
            "currentQuote": {
              "type": "object",
              "required": ["fileName", "startLine", "endLine", "from", "to"],
              "properties": {
                "fileName": { "type": "string" },
                "startLine": { "type": "number" },
                "endLine": { "type": "number" },
                "from": { "type": "number" },
                "to": { "type": "number" },
                "fullContent": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "replayTurns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": { "type": "string" },
              "toolCalls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "arguments"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "arguments": { "oneOf": [{ "type": "object" }, { "type": "string" }] }
                  }
                }
              },
              "fragmentToolCalls": { "type": "boolean" },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "promptTokens": { "type": "number" },
                  "completionTokens": { "type": "number" },
                  "totalTokens": { "type": "number" }
                }
              },
              "createError": { "type": "string" },
              "streamErrorAfterChunks": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolResponses"],
          "properties": {
            "toolResponses": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["ok", "message"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {},
                    "error": { "type": "string" },
                    "changes": { "type": "array" },
                    "throw": { "type": "string" },
                    "delayMs": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "approvalDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["approved"],
            "properties": {
              "approved": { "type": "boolean" },
              "scope": { "enum": ["once", "session"] },
              "reason": { "enum": ["approved", "denied", "timeout", "aborted"] },
              "toolName": { "type": "string" },
              "target": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "expected": {
          "type": "object",
          "required": ["outcome"],
          "properties": {
            "outcome": { "enum": ["success", "partial", "failed", "stopped"] },
            "terminationReason": { "type": "string" },
            "toolSequence": { "type": "array", "items": { "type": "string" } },
            "requestedToolSequence": { "type": "array", "items": { "type": "string" } },
            "forbiddenTools": { "type": "array", "items": { "type": "string" } },
            "arguments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["tool", "path", "equals"],
                "properties": {
                  "tool": { "type": "string" },
                  "call": { "type": "integer", "minimum": 0 },
                  "path": { "type": "string" },
                  "equals": {}
                },
                "additionalProperties": false
              }
            },
            "minimumRetries": { "type": "integer", "minimum": 0 },
            "maximumRealExecutions": { "const": 0 }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
